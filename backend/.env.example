# Copy this file to .env and fill in local secrets and email-provider settings.
DB_URL=jdbc:mysql://localhost:3306/adaptive_teaching_planner?serverTimezone=UTC
DB_USERNAME=planner
DB_PASSWORD=replace-with-a-local-password

# Generate each secret locally with: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
JWT_SECRET_BASE64=generate-a-random-32-byte-secret
OTP_HASH_SECRET_BASE64=generate-a-different-random-32-byte-secret
JWT_ISSUER=adaptive-teaching-planner
JWT_AUDIENCE=adaptive-teaching-planner-teachers
AUTH_COOKIE_SECURE=false
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5175,http://127.0.0.1:5175

# Configure an SMTP provider or a local SMTP inbox such as Mailpit.
MAIL_ENABLED=true
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Adaptive Teaching Planner <no-reply@localhost>
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
