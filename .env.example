# Database connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/teaching_planner?schema=public"

# Resend API Configuration
RESEND_API_KEY="re_placeholder_xxxxxxxxxxxx"
EMAIL_FROM="Teaching Planner <onboarding@resend.dev>"

# Session & JWT Configuration (jose)
JWT_SECRET="replace-with-a-secure-random-secret-at-least-32-chars-long"
JWT_ISSUER="adaptive-teaching-planner"
JWT_AUDIENCE="adaptive-teaching-planner-faculty"
JWT_EXPIRES_IN="7d"

# Optional environment settings
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
